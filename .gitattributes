* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.yaml.example text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
**/.env.example text eol=lf
examples/.env.example text eol=lf
PATCH_VERSION text eol=lf
# check_workflows.py hashes this file byte-for-byte, so it must never be
# line-ending converted on a Windows checkout.
Cargo.lock text eol=lf
# check_contracts.py hashes the schema JSON byte-for-byte and compares it against
# a digest recorded in capabilities.json. Without this rule a Windows checkout
# converts those files to CRLF so the digest never matches locally, while CI on
# Linux stays green — a mismatch that trains people to ignore a red gate.
*.json text eol=lf
# Same reason, different fixture set: check_contracts.py pins the sha256 of each
# auth/v1 token fixture, and `* text=auto` converts these .txt files to CRLF on a
# Windows checkout. A fresh clone reproduced it, so this is not a precaution.
contracts/auth/v1/fixtures/*.txt text eol=lf
# CI verifies the vendored hbb_common with `diff -r` against the upstream
# commit, and these fixtures are part of that comparison: any line-ending
# conversion on checkout would surface as a spurious difference.
libs/hbb_common/tests/data/*.pem -text -diff
