* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.yaml.example text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
**/.env.example text eol=lf
examples/.env.example text eol=lf
PATCH_VERSION text eol=lf
# check_workflows.py hashes this file byte-for-byte, so it must never be
# line-ending converted on a Windows checkout.
Cargo.lock text eol=lf
# check_contracts.py hashes the schema JSON byte-for-byte and compares it against
# a digest recorded in capabilities.json. Without this rule a Windows checkout
# converts those files to CRLF so the digest never matches locally, while CI on
# Linux stays green — a mismatch that trains people to ignore a red gate.
*.json text eol=lf
# Everything under contracts/ is digest-frozen: the patch manifest pins the
# sha256 of each file and check_contracts.py compares them one by one. By the
# time this rule existed it had already bitten three separate classes — the config
# schema JSON, the auth/v1 token fixtures, and a .proto under fast-relay/v1 — each
# discovered only after a fresh clone reproduced it. Naming the whole directory
# stops the next fixture format from costing another round.
#
# If a binary fixture is ever added here, override it with `-text -diff` on that
# path rather than weakening this rule: the gate compares bytes, so any
# conversion is a difference.
contracts/** text eol=lf
# CI verifies the vendored hbb_common with `diff -r` against the upstream
# commit, and these fixtures are part of that comparison: any line-ending
# conversion on checkout would surface as a spurious difference.
libs/hbb_common/tests/data/*.pem -text -diff
